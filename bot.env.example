# Скопируйте в bot.env. Не отправляйте токен в чат и не включайте файл в Git.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
# Дополнительные администраторы и сотрудники: положительные ID через запятую
ADMIN_IDS=
MANAGER_IDS=
# По умолчанию CRM = личный чат основного администратора.
# Для супергруппы укажите отрицательный числовой ID; бот должен иметь доступ.
CRM_CHAT_ID=
CRM_THREAD_ID=
FOLLOWUP_MINUTES=25
AGENT_NAME=МТС Экспресс
DB_PATH=leads.db
# Укажите собственную HTTPS-политику и фактического оператора данных.
PRIVACY_POLICY_URL=
PERSONAL_DATA_OPERATOR=
POLICY_VERSION=2026-01
# Срок выбирает оператор; очистка не запускается автоматически.
RETENTION_DAYS=180
# Необязательно: http://host:port или socks5://host:port
TELEGRAM_PROXY=
